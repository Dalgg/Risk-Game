<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Risk_Game.Views.RoomsWindow"
        Title="Salas"
        Width="600" Height="400"
        Background="#1E1E1E">

    <!-- Contenedor gris central -->
    <Border Background="#5C5C5C" Margin="40">
        <!-- StackPanel para apilar los elementos verticalmente al centro -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25">

            <!-- Título -->
            <TextBlock Text="Salas" Foreground="White" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Botón Crear sala -->
            <Button Content="Crear sala" Background="#0084FF" Foreground="White" FontSize="20" CornerRadius="10"
                Width="220" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

            <!-- Botón Unirse a sala -->
            <Button Content="Unirse a sala" Background="#F4882A" Foreground="White" FontSize="20" CornerRadius="10"
                 Width="220" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

            <!-- Botón Regresar -->
            <Button Content="Regresar" Background="#F92A54" Foreground="White" FontSize="20" CornerRadius="10"
                Width="220" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
