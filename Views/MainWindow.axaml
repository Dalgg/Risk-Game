<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Risk_Game.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="800" Height="550"
        x:Class="Risk_Game.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Risk Challenge"
        Background="#D3D3D3">

    <Grid>
        <!-- Botón superior izquierdo -->
        <Button Content="Iniciar sesión" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
            Background="#333333" Foreground="White" CornerRadius="8" Padding="15,10" FontSize="16"
                Click="OnLoginClick"/>

        <!-- Título Central Superior -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Spacing="5">
            <TextBlock Text="Risk Challenge" FontSize="42" FontWeight="Normal" HorizontalAlignment="Center" Foreground="Black"/>
            <TextBlock Text="A jugar" FontSize="20" HorizontalAlignment="Center" Foreground="#333333"/>
        </StackPanel>

        <!-- Botones Centrales -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25" Margin="0,60,0,0">
            <Button Content="Solitario" Width="220" Height="65" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="#333333" Foreground="White" CornerRadius="8"
                    FontSize="18"/>

            <Button Content="Multijugador" Width="220" Height="65" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="#333333" Foreground="White" CornerRadius="8"
                    FontSize="18" Click="OnRoomsClick"/>

            <Button Content="Salir" Width="220" Height="65" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="#333333" Foreground="White" CornerRadius="8"
                    FontSize="18"/>
        </StackPanel>

        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="60,60,0,0" Background="Transparent"
            BorderThickness="0" Padding="0">
            <StackPanel Spacing="10">
                <Border Width="80" Height="80" Background="White" CornerRadius="4">
                    <Image Source="/Assets/trophy.png" Stretch="Uniform" Margin="10"/>
                </Border>
                <TextBlock Text="Clasificación" HorizontalAlignment="Center" FontSize="18" Foreground="Black"/>
            </StackPanel>
        </Button>

        <!-- Iconos Derechos: Amigos y Ajustes -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,60,60,0" Spacing="40">

            <!-- Amigos -->
            <Button Background="Transparent" BorderThickness="0" Padding="0" >
                <StackPanel Spacing="10">
                    <Border Width="80" Height="80" Background="White" CornerRadius="4">
                        <Image Source="/Assets/friends.png" Stretch="Uniform" Margin="10"/>
                    </Border>
                    <TextBlock Text="Amigos" HorizontalAlignment="Center" FontSize="18" Foreground="Black"/>
                </StackPanel>
            </Button>

            <!-- Ajustes -->
            <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnSettingsClick">
                <StackPanel Spacing="10">
                    <Border Width="80" Height="80" Background="White" CornerRadius="4">
                        <Image Source="/Assets/configuration.png" Stretch="Uniform" Margin="10"/>
                    </Border>
                <TextBlock Text="Ajustes" HorizontalAlignment="Center" FontSize="18" Foreground="Black"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
