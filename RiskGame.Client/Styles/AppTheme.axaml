<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="ProfileLogoutBrush">#A12431</SolidColorBrush>
        <x:Double x:Key="ProfileWidth">600</x:Double>
        <x:Double x:Key="ProfileHeight">760</x:Double>
        <x:Double x:Key="ProfileMinimumHeight">490</x:Double>
        <x:Double x:Key="ProfileAvatarSize">90</x:Double>
        <CornerRadius x:Key="ProfileAvatarRadius">45</CornerRadius>
        <x:Double x:Key="ProfileNicknameSize">22</x:Double>
        <x:Double x:Key="ProfileCatalogItemWidth">100</x:Double>
        <x:Double x:Key="ProfileCatalogImageSize">64</x:Double>
        <Thickness x:Key="ProfileAvatarMargin">0,0,24,0</Thickness>
        <SolidColorBrush x:Key="ScoreboardBackgroundBrush">#181A25</SolidColorBrush>
        <SolidColorBrush x:Key="ScoreboardPanelBrush">#25293A</SolidColorBrush>
        <SolidColorBrush x:Key="ScoreboardBorderBrush">#353A5A</SolidColorBrush>
        <SolidColorBrush x:Key="ScoreboardTextBrush">White</SolidColorBrush>
        <SolidColorBrush x:Key="ScoreboardAccentBrush">#D4A32D</SolidColorBrush>
        <SolidColorBrush x:Key="ScoreboardButtonBrush">#3273B2</SolidColorBrush>
        <SolidColorBrush x:Key="FocusHighlightBrush">#F5D90A</SolidColorBrush>
        <Thickness x:Key="FocusHighlightThickness">3</Thickness>
        <x:Double x:Key="ScoreboardWidth">760</x:Double>
        <x:Double x:Key="ScoreboardHeight">650</x:Double>
        <x:Double x:Key="ScoreboardTitleSize">28</x:Double>
        <x:Double x:Key="ScoreboardTextSize">16</x:Double>
        <x:Double x:Key="ScoreboardSpacing">12</x:Double>
        <x:Double x:Key="ScoreboardButtonHeight">40</x:Double>
        <x:Double x:Key="ScoreboardValueWidth">110</x:Double>
        <Thickness x:Key="ScoreboardWindowMargin">24</Thickness>
        <Thickness x:Key="ScoreboardRowPadding">12,8</Thickness>
        <Thickness x:Key="ScoreboardButtonPadding">16,8</Thickness>
        <Thickness x:Key="ScoreboardBorderThickness">2</Thickness>
        <Thickness x:Key="ScoreboardItemPadding">0</Thickness>
        <CornerRadius x:Key="ScoreboardRadius">8</CornerRadius>
    </Styles.Resources>

    <Style Selector="ListBox.ScoreboardList ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource ScoreboardItemPadding}" />
    </Style>

    <Style Selector="Button.ScoreboardAction">
        <Setter Property="Background" Value="{StaticResource ScoreboardButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ScoreboardTextBrush}" />
        <Setter Property="Height" Value="{StaticResource ScoreboardButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource ScoreboardButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ScoreboardRadius}" />
    </Style>

    <Style Selector="TextBlock.ScoreboardText">
        <Setter Property="Foreground" Value="{StaticResource ScoreboardTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource ScoreboardTextSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Window">
        <Setter Property="WindowState" Value="Maximized" />
    </Style>

    <Style Selector="Control">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{StaticResource FocusHighlightBrush}"
                        BorderThickness="{StaticResource FocusHighlightThickness}"
                        CornerRadius="8"
                        Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource FocusHighlightBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusHighlightThickness}" />
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>

    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource FocusHighlightBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusHighlightThickness}" />
    </Style>

    <Style Selector="TextBox:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource FocusHighlightBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusHighlightThickness}" />
    </Style>

    <Style Selector="ComboBox:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource FocusHighlightBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusHighlightThickness}" />
    </Style>

    <Style Selector="TabItem:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource FocusHighlightBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusHighlightThickness}" />
    </Style>

    <Style Selector="ListBoxItem:focus-visible">
        <Setter Property="BorderBrush" Value="{StaticResource FocusHighlightBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusHighlightThickness}" />
    </Style>
</Styles>
