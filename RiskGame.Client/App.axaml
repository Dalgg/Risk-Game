<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RiskGame.App"
             xmlns:local="using:RiskGame"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForeground">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused">Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextControlBackground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">White</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForeground">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">Black</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused">Black</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
