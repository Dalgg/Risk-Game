<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RiskGame.Resources"
        x:Class="RiskGame.Views.LobbyWindow"
        Title="{x:Static res:Strings.RoomsTitleLabel}"
        Width="850"
        Height="720"
        Background="#181A25">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Margin="20">
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="5"
                    Margin="0,0,0,15">
            <TextBlock Text="{x:Static res:Strings.LobbyTitleLabel}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="RoomCodeTextBlock"
                       FontSize="14"
                       Foreground="#9EA1B2"
                       HorizontalAlignment="Center"
                       LetterSpacing="1" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,10,0,15">
            <Border Grid.Column="0"
                    BorderBrush="#2A2F5B"
                    BorderThickness="2"
                    CornerRadius="8"
                    Margin="0,0,10,0"
                    Padding="15">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="{x:Static res:Strings.LobbyPlayersHeaderLabel}"
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15" />

                    <StackPanel x:Name="PlayersStackPanel" Grid.Row="1" Spacing="8" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#2A2F5B"
                    BorderThickness="2"
                    CornerRadius="8"
                    Margin="10,0,0,0"
                    Padding="15">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="{x:Static res:Strings.LobbyFriendsHeaderLabel}"
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FriendsStackPanel" Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#2A2F5B"
                BorderThickness="2"
                CornerRadius="8"
                Padding="12"
                Height="190"
                Margin="0,0,0,10">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0"
                           Text="{x:Static res:Strings.LobbyChatHeaderLabel}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,8">
                    <StackPanel x:Name="ChatMessagesStackPanel" Spacing="4" />
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                    <TextBox x:Name="ChatInputTextBox"
                             Grid.Column="0"
                             MaxLength="120"
                             PlaceholderText="{x:Static res:Strings.LobbyChatPlaceholder}"
                             VerticalContentAlignment="Center"
                             Height="36"
                             TabIndex="0" />

                    <Button x:Name="SendChatMessageButton"
                            Grid.Column="1"
                            Content="{x:Static res:Strings.LobbyChatSendButton}"
                            Background="#0084FF"
                            Foreground="White"
                            FontWeight="Bold"
                            Width="100"
                            Height="36"
                            Margin="8,0,0,0"
                            CornerRadius="6"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            TabIndex="1"
                            IsDefault="True"
                            Click="SendChatMessageClick" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="LobbyMessageTextBlock"
                   Grid.Row="3"
                   IsVisible="False"
                   Foreground="#FF8A8A"
                   FontSize="13"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto, *, Auto">
            <Button Grid.Column="0"
                    Content="{x:Static res:Strings.LobbyLeaveButton}"
                    Background="#B02C3A"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Width="180"
                    Height="45"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    TabIndex="2"
                    IsCancel="True"
                    Click="LeaveLobbyClick" />

            <Button Grid.Column="2"
                    Content="{x:Static res:Strings.LobbyOptionsButton}"
                    Background="#3B4252"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Width="180"
                    Height="45"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    TabIndex="3" />

            <Button x:Name="LobbyPlayButton"
                    Grid.Column="4"
                    Content="{x:Static res:Strings.LobbyPlayButton}"
                    Background="#D4A32D"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Width="180"
                    Height="45"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    TabIndex="4"
                    IsVisible="False"
                    IsEnabled="False"
                    Click="PlayClick" />
        </Grid>
    </Grid>
</Window>
