<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RiskGame.Resources"
        x:Class="RiskGame.Views.ForgotPasswordWindow"
        Title="{x:Static res:Strings.ForgotPasswordTitle}"
        Width="600" Height="540"
        Background="#181A25">

    <Window.Resources>
        <x:Int32 x:Key="ResetCodeLength">6</x:Int32>
    </Window.Resources>

    <Border Background="#25293A" BorderBrush="#353A5A" BorderThickness="2" CornerRadius="10"
            Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Button Background="#A12431" Width="56" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top"
                    CornerRadius="8,0,8,0" Click="BackClick">
                <Image Source="avares://RiskGame.Client/Assets/back_arrow.png" Margin="5"/>
            </Button>

            <TextBlock Text="{x:Static res:Strings.ForgotPasswordTitle}" Foreground="White" FontSize="24"
                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="60,18,60,0"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock x:Name="MessageTextBlock" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="13" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="35,70,35,0"/>

            <StackPanel x:Name="EmailPanel" VerticalAlignment="Center" Spacing="16" Margin="55,60,55,20">
                <TextBlock Text="{x:Static res:Strings.ForgotPasswordEmailInstructions}" Foreground="#D8DCE8"
                           FontSize="15" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBox x:Name="EmailTextBox" Background="White" Foreground="Black" Height="36"
                         CornerRadius="6"
                         PlaceholderText="{x:Static res:Strings.ForgotPasswordEmailPlaceholder}"/>
                <Button x:Name="SendCodeButton" Content="{x:Static res:Strings.ForgotPasswordSendCodeButton}"
                        Background="#3273B2" Foreground="White" FontSize="16" FontWeight="Bold" CornerRadius="8"
                        Width="210" Height="42" HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        HotKey="Enter" Click="OnSendCodeClick"/>
            </StackPanel>

            <StackPanel x:Name="ResetPanel" IsVisible="False" VerticalAlignment="Center" Spacing="12"
                        Margin="55,95,55,20">
                <TextBlock Text="{x:Static res:Strings.ForgotPasswordResetInstructions}" Foreground="#D8DCE8"
                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBox x:Name="ResetCodeTextBox" Background="White" Foreground="Black" Height="34"
                         CornerRadius="6" MaxLength="{StaticResource ResetCodeLength}"
                         PlaceholderText="{x:Static res:Strings.VerificationCodeLabel}"/>
                <TextBox x:Name="NewPasswordTextBox" Background="White" Foreground="Black" Height="34"
                         CornerRadius="6" PasswordChar="*"
                         PlaceholderText="{x:Static res:Strings.ProfileNewPasswordPlaceholder}"/>
                <TextBox x:Name="ConfirmPasswordTextBox" Background="White" Foreground="Black" Height="34"
                         CornerRadius="6" PasswordChar="*"
                         PlaceholderText="{x:Static res:Strings.ProfileConfirmPasswordPlaceholder}"/>
                <TextBlock Text="{x:Static res:Strings.ProfilePasswordHint}" Foreground="#9EA1B2"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,6,0,0">
                    <Button x:Name="ConfirmResetButton" Content="{x:Static res:Strings.ForgotPasswordConfirmButton}"
                            Background="#3273B2" Foreground="White" FontSize="15" FontWeight="Bold" CornerRadius="8"
                            Width="185" Height="40" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" Click="OnConfirmResetClick"/>
                    <Button x:Name="ResendCodeButton" Content="{x:Static res:Strings.VerificationResend}"
                            Background="#2A2F5B" BorderBrush="#4A5288" BorderThickness="1" Foreground="White"
                            FontSize="14" CornerRadius="8" Width="150" Height="40"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnResendClick"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
