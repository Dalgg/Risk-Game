<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RiskGame.Resources"
        x:Class="RiskGame.Views.RoomsWindow"
        Title="{x:Static res:Strings.RoomsTitleLabel}"
        Width="600"
        Height="480"
        Background="#181A25">

    <Border Background="#25293A"
            BorderBrush="#353A5A"
            BorderThickness="2"
            CornerRadius="10"
            Margin="40">
        <Grid>
            <StackPanel x:Name="MenuButtonsStackPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="22">

                <TextBlock Text="{x:Static res:Strings.RoomsTitleLabel}"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <Button Content="{x:Static res:Strings.RoomsCreateRoomButton}"
                        Background="#3273B2"
                        BorderBrush="#4A8ED1"
                        BorderThickness="1"
                        Foreground="White"
                        FontSize="19"
                        FontWeight="Bold"
                        CornerRadius="10"
                        Width="230"
                        Height="52"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        TabIndex="0"
                        Click="CreateRoomClick" />

                <Button Content="{x:Static res:Strings.RoomsJoinRoomButton}"
                        Background="#D4A32D"
                        BorderBrush="#F5D90A"
                        BorderThickness="1"
                        Foreground="#181A25"
                        FontSize="19"
                        FontWeight="Bold"
                        CornerRadius="10"
                        Width="230"
                        Height="52"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        TabIndex="1"
                        Click="JoinRoomClick" />

                <Button Content="{x:Static res:Strings.GlobalBackButton}"
                        Background="#1E2233"
                        BorderBrush="#A12431"
                        BorderThickness="1.5"
                        Foreground="White"
                        FontSize="18"
                        CornerRadius="10"
                        Width="230"
                        Height="48"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        TabIndex="2"
                        IsCancel="True"
                        Click="BackClick" />

                <TextBlock x:Name="CreateMessageTextBlock"
                           IsVisible="False"
                           Foreground="#FF8A8A"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Width="260" />
            </StackPanel>

            <StackPanel x:Name="JoinCodeStackPanel"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="15"
                        Width="280">

                <TextBlock Text="{x:Static res:Strings.RoomsJoinRoomButton}"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5" />

                <TextBlock Text="{x:Static res:Strings.RoomsCodeLabel}"
                           Foreground="#D4A32D"
                           FontSize="16"
                           HorizontalAlignment="Center" />

                <TextBox x:Name="RoomCodeTextBox"
                         Background="White"
                         Foreground="Black"
                         Height="36"
                         MaxLength="10"
                         CornerRadius="6"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TabIndex="3" />

                <TextBlock x:Name="JoinMessageTextBlock"
                           IsVisible="False"
                           Foreground="#FF8A8A"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="15"
                            Margin="0,10,0,0">

                    <Button Content="{x:Static res:Strings.LoginConfirmButton}"
                            Background="#3273B2"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            CornerRadius="8"
                            Width="130"
                            Height="42"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            TabIndex="4"
                            IsDefault="True"
                            Click="ConfirmJoinRoomClick" />

                    <Button Content="{x:Static res:Strings.GlobalBackButton}"
                            Background="#A12431"
                            Foreground="White"
                            FontSize="16"
                            CornerRadius="8"
                            Width="130"
                            Height="42"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            TabIndex="5"
                            IsCancel="True"
                            Click="CancelJoinRoomClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
