<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiskGame.ViewModels"
        xmlns:res="using:RiskGame.Resources"
        x:Class="RiskGame.Views.ProfileWindow"
        x:DataType="vm:ProfileViewModel"
        Title="{x:Static res:Strings.ProfileTitle}"
        Width="550" Height="490" MinWidth="550" MinHeight="490"
        WindowStartupLocation="CenterScreen" Background="#151722">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>
    <Border BorderBrush="#353A5A" BorderThickness="2" CornerRadius="6" Margin="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">
            <TextBlock Text="{x:Static res:Strings.ProfileTitle}" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="20,0,20,25">
                <Border Width="90" Height="90" CornerRadius="45" Background="#E0E2E8"
                        ClipToBounds="True" BorderBrush="White" BorderThickness="3" Margin="0,0,25,0">
                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"/>
                </Border>
                <Border Grid.Column="1" Background="#1D2136" BorderBrush="#353A5A" BorderThickness="2"
                        CornerRadius="6" Height="50" VerticalAlignment="Center" Padding="15,0">
                    <TextBlock Text="{Binding Username}" FontSize="22" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Username}"/>
                </Border>
            </Grid>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="30,0">
                <TextBlock Text="{x:Static res:Strings.ProfileIdentifier}" FontSize="20" Margin="0,0,15,15"/>
                <TextBlock Grid.Column="1" Text="{Binding UserId}" Foreground="#D1A762" FontSize="20"/>
                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.ProfileMatchesPlayed}"
                           FontSize="20" Margin="0,0,15,15"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MatchesPlayed}"
                           Foreground="#D1A762" FontSize="20"/>
                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.ProfileMatchesWon}"
                           FontSize="20" Margin="0,0,15,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MatchesWon}"
                           Foreground="#D1A762" FontSize="20"/>
            </Grid>
            <StackPanel Grid.Row="3" Spacing="5" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#F2B8B5"/>
                <Button x:Name="RefreshButton" Content="{x:Static res:Strings.ProfileRefresh}"
                        Command="{Binding RetryCommand}"
                        TabIndex="0" HotKey="Enter" HorizontalAlignment="Right"/>
            </StackPanel>
            <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="0,15,0,0">
                <Button Content="{x:Static res:Strings.ProfileBack}" Background="#A12431"
                        Height="40" Margin="0,0,10,0" TabIndex="1" HotKey="Escape"
                        Command="{Binding BackCommand}" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="{x:Static res:Strings.ProfileChangePassword}"
                        Background="#CDA036" Height="40" TabIndex="2" IsEnabled="False"
                        ToolTip.Tip="{x:Static res:Strings.ProfilePasswordPending}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Border>
</Window>
