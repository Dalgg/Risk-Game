<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RiskGame.Resources"
        x:Class="RiskGame.Views.RegisterWindow"
        Title="{x:Static res:Strings.RegisterTitleLabel}"
        Width="600" Height="500"
        Background="#1E1E1E">

    <Window.Resources>
        <Thickness x:Key="VerificationMargin">50,110,50,30</Thickness>
        <x:Double x:Key="VerificationSpacing">15</x:Double>
        <x:Int32 x:Key="VerificationCodeLength">6</x:Int32>
    </Window.Resources>
    <Border Background="#5C5C5C" Width="480" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Button Background="#8B0000" Width="60" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top"
                 CornerRadius="0" Click="BackClick">
                <Image Source="avares://RiskGame.Client/Assets/back_arrow.png" Margin="5"/>
            </Button>

            <TextBlock Text="{x:Static res:Strings.RegisterTitleLabel}" Foreground="White" FontSize="28" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,15,0,0"/>

            <TextBlock x:Name="MessageTextBlock" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="13" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="30,62,30,0"/>

            <Grid x:Name="RegistrationForm" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Margin="50,60,50,0">

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LoginUsernameLabel}" Foreground="White" FontSize="22"
                           VerticalAlignment="Center" Margin="0,0,20,25"/>
                <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1" Background="White" Foreground="Black" Height="35"
                    CornerRadius="0" Margin="0,0,0,25"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LoginPasswordLabel}" Foreground="White" FontSize="22"
                           VerticalAlignment="Center" Margin="0,0,20,25"/>
                <TextBox x:Name="PasswordTextBox" Grid.Row="1" Grid.Column="1" Background="White" Foreground="Black" Height="35"
                    CornerRadius="0" PasswordChar="*" Margin="0,0,0,25"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.RegisterEmailLabel}" Foreground="White" FontSize="22"
                           VerticalAlignment="Center" Margin="0,0,20,25"/>
                <TextBox x:Name="EmailTextBox" Grid.Row="2" Grid.Column="1" Background="White" Foreground="Black" Height="35"
                    CornerRadius="0" Margin="0,0,0,25"/>
        </Grid>

            <Button x:Name="RegisterConfirmButton" Content="{x:Static res:Strings.RegisterConfirmButton}" Background="#0084FF" Foreground="White" FontSize="20" CornerRadius="12"
                Width="180" Height="45" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnConfirmClick" />
            <StackPanel x:Name="VerificationPanel" IsVisible="False" VerticalAlignment="Center"
                        Margin="{StaticResource VerificationMargin}" Spacing="{StaticResource VerificationSpacing}">
                <TextBlock Text="{x:Static res:Strings.VerificationInstructions}" Foreground="White"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="VerificationCodeTextBox" MaxLength="{StaticResource VerificationCodeLength}"
                         TabIndex="0" PlaceholderText="{x:Static res:Strings.VerificationCodeLabel}"/>
                <Button Content="{x:Static res:Strings.VerificationConfirm}" Click="OnVerifyClick"
                        HotKey="Enter" TabIndex="1"/>
                <Button Content="{x:Static res:Strings.VerificationResend}" Click="OnResendClick" TabIndex="2"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
