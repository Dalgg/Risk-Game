<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RiskGame.Resources"
        xmlns:vm="using:RiskGame.ViewModels"
        xmlns:scores="using:RiskGame.Contracts.Scoreboard"
        x:Class="RiskGame.Views.LeaderboardWindow"
        x:DataType="vm:LeaderboardViewModel"
        Title="{x:Static res:Strings.LeaderboardTitle}"
        Width="{StaticResource ScoreboardWidth}"
        Height="{StaticResource ScoreboardHeight}"
        MinWidth="{StaticResource ScoreboardWidth}"
        MinHeight="{StaticResource ScoreboardHeight}"
        Background="{StaticResource ScoreboardBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Margin="{StaticResource ScoreboardWindowMargin}">
        <StackPanel Spacing="{StaticResource ScoreboardSpacing}">
            <TextBlock FontSize="{StaticResource ScoreboardTitleSize}"
                       Foreground="{StaticResource ScoreboardAccentBrush}"
                       Text="{x:Static res:Strings.LeaderboardTitle}" />
            <TextBlock Classes="ScoreboardText"
                       Text="{x:Static res:Strings.LeaderboardOrderingRuleLabel}" />
            <TextBlock Classes="ScoreboardText"
                       Text="{Binding ScopeLabel}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource ScoreboardRowPadding}"
                    Spacing="{StaticResource ScoreboardSpacing}"
                    Orientation="Horizontal">
            <Button x:Name="GlobalButton"
                    Classes="ScoreboardAction"
                    Content="{x:Static res:Strings.LeaderboardGlobalButton}"
                    Command="{Binding GlobalCommand}"
                    TabIndex="0" />
            <Button x:Name="FriendsButton"
                    Classes="ScoreboardAction"
                    Content="{x:Static res:Strings.LeaderboardFriendsButton}"
                    Command="{Binding FriendsCommand}"
                    TabIndex="1" />
            <Button x:Name="SortButton"
                    Classes="ScoreboardAction"
                    Content="{x:Static res:Strings.LeaderboardSortButton}"
                    Command="{Binding SortCommand}"
                    TabIndex="2" />
            <Button x:Name="RefreshButton"
                    Classes="ScoreboardAction"
                    Content="{x:Static res:Strings.LeaderboardRefreshButton}"
                    Command="{Binding RefreshCommand}"
                    TabIndex="3"
                    IsDefault="True" />
        </StackPanel>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="{StaticResource ScoreboardRowPadding}">
            <TextBlock Classes="ScoreboardText"
                       Text="{x:Static res:Strings.LeaderboardPlayerLabel}" />
            <TextBlock Grid.Column="1"
                       Classes="ScoreboardText"
                       Width="{StaticResource ScoreboardValueWidth}"
                       Text="{x:Static res:Strings.LeaderboardWinsLabel}" />
            <TextBlock Grid.Column="2"
                       Classes="ScoreboardText"
                       Width="{StaticResource ScoreboardValueWidth}"
                       Text="{x:Static res:Strings.LeaderboardColumnsLabel}" />
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource ScoreboardPanelBrush}"
                BorderBrush="{StaticResource ScoreboardBorderBrush}"
                BorderThickness="{StaticResource ScoreboardBorderThickness}"
                CornerRadius="{StaticResource ScoreboardRadius}">
            <ListBox Classes="ScoreboardList"
                     Background="{StaticResource ScoreboardPanelBrush}"
                     ItemsSource="{Binding Players}"
                     TabIndex="4"
                     AutomationProperties.Name="{x:Static res:Strings.LeaderboardTitle}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="scores:ScoreEntry">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Margin="{StaticResource ScoreboardRowPadding}">
                            <TextBlock Classes="ScoreboardText"
                                       Text="{Binding Username}" />
                            <TextBlock Grid.Column="1"
                                       Classes="ScoreboardText"
                                       Width="{StaticResource ScoreboardValueWidth}"
                                       Text="{Binding TotalWins}" />
                            <TextBlock Grid.Column="2"
                                       Classes="ScoreboardText"
                                       Width="{StaticResource ScoreboardValueWidth}"
                                       Text="{Binding TotalScore}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="4"
                   Classes="ScoreboardText"
                   Margin="{StaticResource ScoreboardRowPadding}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <Button x:Name="BackButton"
                Grid.Row="5"
                Classes="ScoreboardAction"
                HorizontalAlignment="Center"
                Content="{x:Static res:Strings.GlobalBackButton}"
                Command="{Binding BackCommand}"
                TabIndex="5"
                IsCancel="True" />
    </Grid>
</Window>
