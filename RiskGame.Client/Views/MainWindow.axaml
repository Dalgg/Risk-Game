<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RiskGame.ViewModels"
        xmlns:res="using:RiskGame.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="800" Height="550"
        x:Class="RiskGame.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static res:Strings.GlobalGameTitle}"
        Background="#D3D3D3">

    <Window.Resources>
        <Thickness x:Key="InboxButtonMargin">0,20,20,0</Thickness>
        <Thickness x:Key="InboxButtonPadding">15,10</Thickness>
        <CornerRadius x:Key="InboxButtonCornerRadius">8</CornerRadius>
    </Window.Resources>
    <Grid>
        <Button Content="{x:Static res:Strings.InboxTitle}" Click="OnInboxClick"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="{StaticResource InboxButtonMargin}" Padding="{StaticResource InboxButtonPadding}"
                CornerRadius="{StaticResource InboxButtonCornerRadius}"
                Background="#333333" Foreground="White"/>
        <Button Content="{x:Static res:Strings.LoginTitleLabel}" 
                IsVisible="{Binding IsGuest}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Background="#333333" Foreground="White" CornerRadius="8" Padding="15,10" FontSize="16"
                Click="OnLoginClick"/>

        <Button IsVisible="{Binding IsLoggedIn}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Background="#333333" Foreground="White" CornerRadius="8" Padding="10"
                Command="{Binding OpenProfileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="White">
                    <Image Source="/Assets/default_avatar.png" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="{Binding LoggedUsername}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Spacing="5">
            <TextBlock Text="{x:Static res:Strings.GlobalGameTitle}" FontSize="42" FontWeight="Normal" HorizontalAlignment="Center" Foreground="Black"/>
            <TextBlock Text="{x:Static res:Strings.MainMenuStartButton}" FontSize="20" HorizontalAlignment="Center" Foreground="#333333"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="25" Margin="0,60,0,0">
            <Button Content="{x:Static res:Strings.MainMenuRoomsButton}" Width="220" Height="65" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="#333333" Foreground="White" CornerRadius="8"
                    FontSize="18" Click="OnRoomsClick"/>

            <Button Content="{x:Static res:Strings.MainMenuExitButton}" Width="220" Height="65" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" Background="#333333" Foreground="White" CornerRadius="8"
                    FontSize="18" Click="OnExitClick"/>
        </StackPanel>

        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="60,60,0,0" Background="Transparent"
            BorderThickness="0" Padding="0" Click="OnLeaderboardClick">
            <StackPanel Spacing="10">
                <Border Width="80" Height="80" Background="White" CornerRadius="4">
                    <Image Source="/Assets/trophy.png" Stretch="Uniform" Margin="10"/>
                </Border>
                <TextBlock Text="{x:Static res:Strings.MainMenuLeaderboardButton}" HorizontalAlignment="Center" FontSize="18" Foreground="Black"/>
            </StackPanel>
        </Button>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,60,60,0" Spacing="40">

            <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnFriendsClick">
                <StackPanel Spacing="10">
                    <Border Width="80" Height="80" Background="White" CornerRadius="4">
                        <Image Source="/Assets/friends.png" Stretch="Uniform" Margin="10"/>
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.MainMenuFriendsButton}" HorizontalAlignment="Center" FontSize="18" Foreground="Black"/>
                </StackPanel>
            </Button>

            <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnSettingsClick">
                <StackPanel Spacing="10">
                    <Border Width="80" Height="80" Background="White" CornerRadius="4">
                        <Image Source="/Assets/configuration.png" Stretch="Uniform" Margin="10"/>
                    </Border>
                <TextBlock Text="{x:Static res:Strings.MainMenuSettingsButton}" HorizontalAlignment="Center" FontSize="18" Foreground="Black"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
